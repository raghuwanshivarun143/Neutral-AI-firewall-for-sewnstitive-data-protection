# =============================================================================
# CIPHER01 AI FIREWALL — ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.
# =============================================================================

# --- AI PROVIDER KEYS (fill only the ones you use) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
AZURE_OPENAI_API_KEY=
GROQ_API_KEY=

# --- AI PROVIDER BASE URLS (change if using proxy/custom endpoint) ---
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- DATABASE ---
DATABASE_URL=sqlite:///./cipher01.db
# PostgreSQL example: DATABASE_URL=postgresql://user:password@localhost:5432/cipher01

# --- REDIS (optional, falls back to in-memory if unavailable) ---
REDIS_URL=redis://localhost:6379

# --- CIPHER01 SECURITY ---
CIPHER01_SECRET_KEY=change-this-to-a-random-32-char-secret
CIPHER01_MASTER_KEY=change-this-to-another-random-secret

# --- APP SETTINGS ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- CORS / FRONTEND ---
FRONTEND_URL=http://localhost:3000

# --- DEFAULT PROVIDER ---
DEFAULT_PROVIDER=openai
DEFAULT_MODEL=gpt-4o-mini

# --- SCANNER SETTINGS ---
MAX_DECODE_DEPTH=3
MAX_PAYLOAD_SIZE_MB=10
SCAN_TIMEOUT_SECONDS=30

# --- FEATURE FLAGS ---
ENABLE_REDIS=false
ENABLE_PRESIDIO=false
ENABLE_OCR=false
ENABLE_CANARY_TOKENS=true
